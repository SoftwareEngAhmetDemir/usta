# Copy to backend/.env and fill in. backend/.env is git-ignored.
# System dependencies: ffmpeg (brew install ffmpeg), tesseract (brew install tesseract) + Turkish/Arabic language files
# in backend/.tessdata (eng/osd copied from the brew tessdata dir, tur/ara from github.com/tesseract-ocr/tessdata_fast).
# Local models download from Hugging Face on first use (~4 GB): faster-whisper small, multilingual-e5-base,
# bge-reranker-v2-m3.
# App connects as the least-privilege `usta` user (rights on usta + usta_test only).
DATABASE_URL=mysql+asyncmy://usta:CHANGE_ME@127.0.0.1:3306/usta
TEST_DATABASE_URL=mysql+asyncmy://usta:CHANGE_ME@127.0.0.1:3306/usta_test

# Admin tasks only (creating databases/users). The app never uses root.
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Files saved on disk; MySQL stores their paths.
UPLOADS_DIR=../uploads

# Session cookie signing key: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=CHANGE_ME

# Address phones open from the QR sticker. Empty = the address the sticker was downloaded from (open the app at the
# VS Code forwarded https URL to print stickers); set it to that URL when printing from http://localhost.
PUBLIC_URL=

# Gemini: only the final "Makineye sor" answer and document summaries. Vertex AI = a Cloud project + region, after
# `gcloud auth application-default login` (Vertex AI API enabled), or GEMINI_API_KEY (AI Studio).
# Without it: answers say "not found" (→ Ustaya sor) and documents get no summary; search/transcription still work.
# Translation and dubbing speech use Google's free translate endpoints: no key, nothing to enable.
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Local knowledge pipelines (CPU). Changing EMBEDDING_MODEL re-embeds every chunk at the next start.
# WHISPER_MODEL=small                       (tiny | base | small | medium | large-v3)
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# CHROMA_DIR=.chroma                        (vector store; one process only, the backend)
# TESSDATA_DIR=.tessdata
# OCR_LANGUAGES=tur+eng+ara

# Thresholds
# ASK_MIN_SCORE=0.08                        (rerank gate: below = "not found", no LLM call)
# ASK_CANDIDATES=20                         (per retriever: vector and BM25)
# ASK_TOP_K=5                               (sent to the LLM)
# TOPIC_DEPTH_SD=0.5                        (higher = fewer topics)
# TOPIC_WINDOW=2
# TOPIC_MIN_SEC=20
# TOPIC_MAX_SEC=180
# SNAPSHOT_MIN_SHARPNESS=15
# MAX_UPLOAD_MB=1024
