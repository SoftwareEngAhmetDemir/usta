# Copy to backend/.env and fill in. backend/.env is git-ignored.
# App connects as the least-privilege `usta` user (rights on usta + usta_test only).
DATABASE_URL=mysql+asyncmy://usta:CHANGE_ME@127.0.0.1:3306/usta
TEST_DATABASE_URL=mysql+asyncmy://usta:CHANGE_ME@127.0.0.1:3306/usta_test

# Admin tasks only (creating databases/users). The app never uses root.
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Files saved on disk; MySQL stores their paths.
UPLOADS_DIR=../uploads

# Session cookie signing key: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=CHANGE_ME

# Address phones open from the QR sticker: the VS Code forwarded-port URL when sharing (default http://localhost:5173).
PUBLIC_URL=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey). Without it: "Makineye sor" always answers "not found",
# videos play without subtitles/dubbing, documents get no summary. Restart the backend after setting it:
# failed transcriptions are retried once at startup.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# ASK_MIN_SCORE=0.6
# MAX_UPLOAD_MB=1024
